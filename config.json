{
  "data_path": "data",
  "rates_ttl_seconds": 100,
  "base_currency": "USD",
  "log_path": "logs",
  "log_file_name": "parser.log",
  "logger_name": "logger_1",
  "supported_currency": ["USD", "EUR", "BTC", "RUB","ETH"],

  "data_format_local": "%Y-%m-%dT%H:%M:%S",
  "data_format_utc": "%Y-%m-%dT%H:%M:%SZ",

  "allowed_chars" : "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-!@#*",
  "commands_signature" : {
        "exit": {},
        "help": {},
        "register": {
            "--username": {"exist": true, "type": "str"},
            "--password": {"exist": true, "min_len": 4, "type": "str"}},
        "login": {
            "--username": {"exist": true, "type": "str"},
            "--password": {"exist": true, "min_len": 4, "type": "str"}},
        "buy": {
            "--currency": {"exist": true, "type": "str",
                          "currency_code_validation":["USD", "EUR", "BTC", "RUB","ETH"]},
            "--amount":   {"exist": true, "type": "float"}},
        "sell": {
            "--currency": {"exist": true, "type": "str",
                          "currency_code_validation":["USD", "EUR", "BTC", "RUB","ETH"]},
            "--amount":   {"exist": true, "type": "float"}},
        "get-rate": {
            "--from":     {"exist": true, "type": "str",
                          "currency_code_validation":["USD", "EUR", "BTC", "RUB","ETH"]},
            "--to":       {"exist": true, "type": "str",
                          "currency_code_validation": ["USD", "EUR", "BTC", "RUB","ETH"]}},
        "show-portfolio": {
            "--base":     {"exist": false, "type": "str",
                          "currency_code_validation": ["USD", "EUR", "BTC", "RUB","ETH"]}},
        "show-rates": {
            "--currency": {"exist": false, "type": "str",
                          "currency_code_validation":["USD", "EUR", "BTC", "RUB","ETH"]},
            "--top":      {"exist": false, "type": "int"},
            "--base":     {"exist": false, "type": "str",
                          "currency_code_validation":["USD", "EUR", "BTC", "RUB","ETH"]}},
        "update-rates": {
            "--source":   {"exist": false, "type": "str"}},
        "change-password": {
            "--password": {"exist": true, "min_len": 4, "type": "str"}},
        "scheduler-run": {}
      },
  "currencies": {
      "RUB": {
          "type": "fiat",
          "name": "Russian rubble",
          "issuing_country": "Russian Federation"
      },
      "USD": {
          "type": "fiat",
          "name": "US Dollar",
          "issuing_country": "United States"
      },
      "EUR": {
          "type": "fiat",
          "name": "EURO",
          "issuing_country": "Euro Zone"
      },
      "BTC": {
          "type": "crypto",
          "name": "Bitcoin",
          "algorithm": "SHA-256",
          "market_cap": 1700000000000
      },
      "ETH": {
          "type": "crypto",
          "name": "Ethereum",
          "algorithm": "Ethash",
          "market_cap": 310000000000
      }
  }
}